{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "order_id": {
        "type": "keyword"
      },
      "status": {
        "type": "keyword"
      },
      "cancel_reason": {
        "type": "keyword"
      },
      "customer_email": {
        "type": "keyword"
      },
      "product_names": {
        "type": "text",
        "analyzer": "english"
      },
      "items": {
        "type": "nested",
        "properties": {
          "product_id": {
            "type": "keyword"
          },
          "name": {
            "type": "text",
            "analyzer": "english",
            "fields": {
              "raw": {
                "type": "keyword"
              }
            }
          },
          "quantity": {
            "type": "integer"
          },
          "unit_price_cents": {
            "type": "integer"
          }
        }
      },
      "total": {
        "type": "scaled_float",
        "scaling_factor": 100
      },
      "created_at": {
        "type": "date"
      },
      "updated_at": {
        "type": "date"
      }
    }
  }
}
